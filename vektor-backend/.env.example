ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://vektor:vektor@localhost:5432/vektor
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
ADMIN_EMAIL=admin@shkola-vektor.ru
ADMIN_PASSWORD=change-me-min-8-chars

# ВРЕМЕННО (Этап 3.7): общий пароль для массово заведённых пользователей.
# Позже заменится авто-генерацией + рассылкой.
BULK_DEFAULT_PASSWORD=change-me-min-8-chars

LOG_LEVEL=INFO

# Печатать каждый SQL-запрос. По умолчанию выключено: эхо топит access-лог
# (на одном запросе к результатам — десятки строк). Включайте точечно,
# когда нужно разглядывать запросы.
DB_ECHO=false

# Разрешённые Origin для CORS, через запятую.
# В разработке НЕ НУЖНО: фронт ходит через прокси Vite (/api → :8000), и для
# браузера это один origin. Заполняйте, только если фронт отдаётся с другого
# домена, чем API. Пусто = middleware не подключается вовсе.
CORS_ORIGINS=

